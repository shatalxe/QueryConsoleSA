
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ДоступныеТипы", ДоступныеТипы);
	ЗаполнитьДеревоМетаданных();
	
	ПолноеИмяТипаОбъекта = Неопределено;
	СсылкаНаОбъект		 = Неопределено;  
	
	Если Параметры.Свойство("СсылкаНаОбъект", СсылкаНаОбъект) 
		И ЭтоСсылка(СсылкаНаОбъект) Тогда
		МетаданныеОбъекта = Параметры.СсылкаНаОбъект.Метаданные();
		ПолноеИмяТипаОбъекта = МетаданныеОбъекта.ПолноеИмя();
	ИначеЕсли Параметры.Свойство("ПолноеИмяТипаОбъекта") И Не ПустаяСтрока(Параметры.ПолноеИмяТипаОбъекта) Тогда
		ПолноеИмяТипаОбъекта = Параметры.ПолноеИмяТипаОбъекта;
	ИначеЕсли ЗначениеЗаполнено(ДоступныеТипы) Тогда
		ПолноеИмяТипаОбъекта = Метаданные.НайтиПоТипу(ДоступныеТипы.Типы()[0]).ПолноеИмя();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПолноеИмяТипаОбъекта) Тогда
		// Раскроем нужную ветвь и спозиционируемся на текущем типе объекта
		Элементы.ТипыОбъектов.ТекущаяСтрока = ПолучитьИдентификаторИзДереваТипов(ПолноеИмяТипаОбъекта);
		ПолучитьСписокОбъектов(Элементы.ТипыОбъектов.ТекущаяСтрока); 
	Иначе
		// Примитивные типы
		Элементы.ТипыОбъектов.ТекущаяСтрока = ПолучитьИдентификаторИзДереваТипов(Строка(ТипЗнч(СсылкаНаОбъект)));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		// Спозиционируемся в списке на текущий элемент
		Элементы.СписокОбъектов.ТекущаяСтрока = СсылкаНаОбъект;
	КонецЕсли;
	
	УправлениеДоступностьВидимостью(ЭтаФорма);    	
	
	Если Параметры.Свойство("СкрытьСтрокуПоиска") Тогда
		Элементы.ТипыОбъектов.ПоложениеСтрокиПоиска = ПоложениеСтрокиПоиска.Нет;	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ТипыОбъектовПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ТипыОбъектов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ИдентификаторСтрокиСпискаОбъектов <> Элементы.ТипыОбъектов.ТекущаяСтрока Тогда  
		// Если изменилась текущая строка таблицы ТипыОбъектов.
		ЕстьГруппы = Ложь;
		ИмяТипаОбъектов = "";	
		ПолучитьСписокОбъектов(Элементы.ТипыОбъектов.ТекущаяСтрока);		 
	КонецЕсли;  
	
	УправлениеДоступностьВидимостью(ЭтаФорма);
	
КонецПроцедуры  

&НаКлиенте
Процедура ТипыОбъектовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
		
	ЗавершитьВыборЗначения(Элемент);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьЗначение(Команда)
	ЗавершитьВыборЗначения(Элементы.ТипыОбъектов, Истина);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДеревоМетаданных()
	
	ТипыОбъектовДерево = РеквизитФормыВЗначение("ТипыОбъектов", Тип("ДеревоЗначений"));	
	ТипыОбъектовДерево.Строки.Очистить();
	
	ПриметивныеТипы = Новый Массив;
	ПриметивныеТипы.Добавить("Булево"); 
	ПриметивныеТипы.Добавить("Дата");
	ПриметивныеТипы.Добавить("Строка");
	ПриметивныеТипы.Добавить("Число");

	Для Каждого ТекущийТип Из ПриметивныеТипы Цикл  
		СтрокаДерева		 = ТипыОбъектовДерево.Строки.Добавить();
		СтрокаДерева.Имя	 = ТекущийТип;
		СтрокаДерева.Синоним = ТекущийТип;
	КонецЦикла;      
	
	СтрокаДерева		 = ТипыОбъектовДерево.Строки.Добавить();
	СтрокаДерева.Имя	 = "СписокЗначений";
	СтрокаДерева.Синоним = "Список значений";
	
	СписокКоллекцийМетаданных = Новый СписокЗначений;
	СписокКоллекцийМетаданных.Добавить("Документы", 				"Документы");
	СписокКоллекцийМетаданных.Добавить("Справочники", 				"Справочники");
	СписокКоллекцийМетаданных.Добавить("ПланыВидовХарактеристик", 	"Планы видов характеристик");
	СписокКоллекцийМетаданных.Добавить("ПланыСчетов", 				"Планы счетов");
	СписокКоллекцийМетаданных.Добавить("ПланыВидовРасчета", 		"Планы видов расчета");
	СписокКоллекцийМетаданных.Добавить("Задачи", 					"Задачи");
	СписокКоллекцийМетаданных.Добавить("БизнесПроцессы",			"Бизнес-процессы");
	СписокКоллекцийМетаданных.Добавить("ПланыОбмена",				"Планы обмена");
	СписокКоллекцийМетаданных.Добавить("Перечисления",				"Перечисления");
	
	Для Каждого КоллекцияМетаданных Из СписокКоллекцийМетаданных Цикл
		
		СтрокаДерева			 = ТипыОбъектовДерево.Строки.Добавить();
		СтрокаДерева.Имя		 = КоллекцияМетаданных.Значение;
		СтрокаДерева.Синоним	 = КоллекцияМетаданных.Представление;
		ЕстьДобавленныеСтроки	 = Ложь;
		
		Для Каждого МетаОбъект Из Метаданные[КоллекцияМетаданных.Значение] Цикл
			
			СтрокаДок			 = СтрокаДерева.Строки.Добавить();
			СтрокаДок.Имя		 = МетаОбъект.Имя;
			СтрокаДок.Синоним	 = ?(ЗначениеЗаполнено(МетаОбъект.Синоним), МетаОбъект.Синоним, МетаОбъект.Имя);
			СтрокаДок.ПолноеИмя	 = МетаОбъект.ПолноеИмя();
			
			ЕстьДобавленныеСтроки = Истина;   
			
		КонецЦикла;
		
		Если Не ЕстьДобавленныеСтроки Тогда
			ТипыОбъектовДерево.Строки.Удалить(СтрокаДерева);
		КонецЕсли; 
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ТипыОбъектовДерево, "ТипыОбъектов");
	
КонецПроцедуры

&НаСервере
Процедура ОткрытьСписокОбъектов(МетаОбъекта)

	ИмяТаблицаИБ = МетаОбъекта.ПолноеИмя();
	
	СписокОбъектов.ПроизвольныйЗапрос = Истина;
	СписокОбъектов.ТекстЗапроса = 
		"ВЫБРАТЬ УФО_Таблица_Объект.Ссылка КАК Ссылка 
		|ИЗ
		|	" + ИмяТаблицаИБ + " КАК УФО_Таблица_Объект";
	СписокОбъектов.ДинамическоеСчитываниеДанных = Истина;
	СписокОбъектов.ОсновнаяТаблица = ИмяТаблицаИБ;
	
	СвойстваИерархии = Новый Структура("Иерархический, ВидИерархии", Ложь);
	ЗаполнитьЗначенияСвойств(СвойстваИерархии, МетаОбъекта); 
	ЕстьГруппы = (СвойстваИерархии.Иерархический И СвойстваИерархии.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов);
	
	ИмяТипаОбъектов = МетаОбъекта.Представление();
	
	РанееДобавленнаяКолонкаСсылка = Элементы.Найти("СписокОбъектовСсылка");	
	Если РанееДобавленнаяКолонкаСсылка <> Неопределено Тогда
		// Ранее уже добавляли колонку под Ссылку
		Элементы.Удалить(РанееДобавленнаяКолонкаСсылка);
	Иначе
		// Скроем фиктивную колонку под Ссылку
		Элементы.СписокОбъектов_Ссылка.Видимость = Ложь;
	КонецЕсли;
	
	Элемент = Элементы.Добавить("СписокОбъектовСсылка", Тип("ПолеФормы"), Элементы.СписокОбъектов);
	Элемент.ПутьКДанным = "СписокОбъектов.Ссылка";
	      	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеДоступностьВидимостью(Форма)
	
	Форма.Элементы.ГруппаСписокОбъектов.Заголовок = Форма.ИмяТипаОбъектов;
	Форма.Элементы.ГруппаСписокОбъектов.Видимость = ЗначениеЗаполнено(Форма.ИмяТипаОбъектов);  

	Если ЗначениеЗаполнено(Форма.ИмяТипаОбъектов) Тогда
		Форма.Элементы.СписокОбъектов.ПоложениеСтрокиПоиска = ПоложениеСтрокиПоиска.Авто; 
	Иначе
		Форма.Элементы.СписокОбъектов.ПоложениеСтрокиПоиска = ПоложениеСтрокиПоиска.Нет; 
	КонецЕсли;
	
	ТекущиеДанные = Форма.ТипыОбъектов.НайтиПоИдентификатору(Форма.Элементы.ТипыОбъектов.ТекущаяСтрока);
 
	Форма.Элементы.ЗначениеБулево.Видимость = (ТекущиеДанные.Имя = "Булево");	
	Форма.Элементы.ЗначениеЧисло.Видимость = (ТекущиеДанные.Имя = "Число");	
	Форма.Элементы.ЗначениеДата.Видимость = (ТекущиеДанные.Имя = "Дата");	
	Форма.Элементы.ЗначениеСтрока.Видимость = (ТекущиеДанные.Имя = "Строка");	
	Форма.Элементы.ЗначениеСписокЗначений.Видимость = (ТекущиеДанные.Имя = "СписокЗначений");	

КонецПроцедуры

&НаСервере
Функция ПолучитьИдентификаторИзДереваТипов(ПолноеИмяТипаОбъекта)
	
	Для Каждого УзелДерева Из ТипыОбъектов.ПолучитьЭлементы() Цикл
		Для Каждого ТипОбъекта Из УзелДерева.ПолучитьЭлементы() Цикл
			Если ТипОбъекта.ПолноеИмя = ПолноеИмяТипаОбъекта Тогда
				Возврат ТипОбъекта.ПолучитьИдентификатор();
			КонецЕсли;
		КонецЦикла; 
		Если УзелДерева.Имя = ПолноеИмяТипаОбъекта Тогда
			Возврат УзелДерева.ПолучитьИдентификатор();
		КонецЕсли;
	КонецЦикла;	
	
	Возврат 0;
	
КонецФункции

&НаСервере
Процедура ПолучитьСписокОбъектов(ВыбраннаяСтрока)
	
	ИдентификаторСтрокиСпискаОбъектов = ВыбраннаяСтрока;

	ТекущаяСтрока	 = ТипыОбъектов.НайтиПоИдентификатору(ВыбраннаяСтрока);
	РодительСтроки	 = ТекущаяСтрока.ПолучитьРодителя();
	Если РодительСтроки = Неопределено Тогда 
		Возврат;
	КонецЕсли; 
	
	ВеткаКлассаОбъектов	 = РодительСтроки.Имя;
	ИмяКлассаОбъекта	 = ТекущаяСтрока.Имя;
	
	МетаОбъекта = Метаданные[ВеткаКлассаОбъектов][ИмяКлассаОбъекта];	
	ОткрытьСписокОбъектов(МетаОбъекта);	
		
КонецПроцедуры

&НаСервере
Функция НовыйОбъектНаСервере()
	
	Если Не ЗначениеЗаполнено(СписокОбъектов.ОсновнаяТаблица) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 0
	               |	Объект.Ссылка КАК Ссылка
	               |ИЗ
	               |	" + СписокОбъектов.ОсновнаяТаблица + " КАК Объект";
				   
	Выгрузка = Запрос.Выполнить().Выгрузить();
	
	// Получим Тип в попытке
	Попытка
		Если Выгрузка.Колонки.Ссылка.ТипЗначения.Типы()[0] = ТипЗнч(null) Тогда
			ТипОбъекта = Выгрузка.Колонки.Ссылка.ТипЗначения.Типы()[1];
		Иначе
			ТипОбъекта = Выгрузка.Колонки.Ссылка.ТипЗначения.Типы()[0];
		КонецЕсли;
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось определить тип объекта";
		Сообщение.Сообщить();
		
		Возврат Неопределено;
	КонецПопытки;
	
	// Создадим Объект в попытке
	Попытка
		НоваяСсылкаНаОбъект = Новый (ТипОбъекта);
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось создать объект";
		Сообщение.Сообщить();
		
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат НоваяСсылкаНаОбъект;
	
КонецФункции

// Проверка явялется ли переданный параметром ссылкой на объект (документ, справочник и пр.)
// 
// Параметры:
// 	Объект - ЛюбаяСсылка, Тип - проверяемый обхект
// Возвращаемое значение:
// 	Булево - Истина - это объект является ссылкой
&НаСервереБезКонтекста
Функция ЭтоСсылка(Объект) Экспорт
	
	Если ТипЗнч(Объект) = Тип("Тип") Тогда
		ПроверяемыйТип = Объект;
	Иначе
		ПроверяемыйТип = ТипЗнч(Объект);
	КонецЕсли;
	
	МетаданныеОбъекта = Метаданные.НайтиПоТипу(ПроверяемыйТип);

	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяОбъектаМетаданных = МетаданныеОбъекта.ПолноеИмя();
	Позиция = Найти(ИмяОбъектаМетаданных, ".");
	Если Позиция > 0 Тогда 
		ИмяБазовогоТипа = Лев(ИмяОбъектаМетаданных, Позиция - 1);
		Возврат ИмяБазовогоТипа = "Справочник"
			Или ИмяБазовогоТипа = "Документ"
			Или ИмяБазовогоТипа = "БизнесПроцесс"
			Или ИмяБазовогоТипа = "Задача"
			Или ИмяБазовогоТипа = "ПланСчетов"
			Или ИмяБазовогоТипа = "ПланОбмена"
			Или ИмяБазовогоТипа = "ПланВидовХарактеристик"
			Или ИмяБазовогоТипа = "ПланВидовРасчета"
			Или ИмяБазовогоТипа = "Перечисление";
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьВыборЗначения(Элемент, ЗначениеВыбрано = Ложь)
	
	Если Элемент.ТекущиеДанные.Имя = "Булево" Тогда
		Закрыть(ЗначениеБулево);
	ИначеЕсли Элемент.ТекущиеДанные.Имя = "Строка" Тогда
		Закрыть(ЗначениеСтрока);  
	ИначеЕсли Элемент.ТекущиеДанные.Имя = "Число" Тогда
		Закрыть(ЗначениеЧисло);
	ИначеЕсли Элемент.ТекущиеДанные.Имя = "Дата" Тогда
		Закрыть(ЗначениеДата);      
	ИначеЕсли Элемент.ТекущиеДанные.Имя = "СписокЗначений" Тогда
		Закрыть(ЗначениеСписокЗначений);
	ИначеЕсли ЗначениеЗаполнено(ИмяТипаОбъектов) Тогда      
		Если ЗначениеВыбрано Тогда 
			Закрыть(Элементы.СписокОбъектов.ТекущиеДанные.Ссылка);	
		Иначе	
			Закрыть(ПредопределенноеЗначение(Элементы.ТипыОбъектов.ТекущиеДанные.ПолноеИмя + ".ПустаяСсылка"));	
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
