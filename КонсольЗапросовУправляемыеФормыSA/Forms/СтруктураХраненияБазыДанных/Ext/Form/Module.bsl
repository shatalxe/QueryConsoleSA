
#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновитьДеревоНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьДеревоНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьДеревоНаСервере()
	
	СтруктураХранения = ПолучитьСтруктуруХраненияБазыДанных(, Истина);
	Дерево = РеквизитФормыВЗначение("ДеревоХранения");   
	Дерево.Строки.Очистить();

	Для Каждого ТекТаблица Из СтруктураХранения Цикл
		
		СтрокаДерева = Дерево.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева, ТекТаблица);
				
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоХранения");	

КонецПроцедуры

#КонецОбласти


