
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КопироватьДанныеФормы(Параметры.Дерево, ДеревоНастроек);
	Элементы.ДеревоНастроек.ТекущаяСтрока = ИдентификаторСтрокиДереваИзПути(Параметры.ТекущаяСтрока);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДеревоНастроекВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;	
	ВыбратьИЗакрыть();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	ВыбратьИЗакрыть();	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ИдентификаторСтрокиДереваИзПути(Путь)
	
	МассивИндексов = РеквизитФормыВЗначение("Объект").РазложитьСтрокуВМассивПодстрок(Путь);
	
	Если МассивИндексов.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	ТекущаяКоллекция = ДеревоНастроек.ПолучитьЭлементы(); 
	
	Для Каждого Индекс Из МассивИндексов Цикл  
		
		Индекс = Число(Индекс);
		
		Если ТекущаяКоллекция.Количество() <= Индекс Тогда 
			Возврат 0; // Путь не соответсвует настройкам. 
		Иначе
			ТекущиеДанные = ТекущаяКоллекция.Получить(Индекс);
		КонецЕсли;
		
		ТекущаяКоллекция = ТекущиеДанные.ПолучитьЭлементы();
				
	КонецЦикла;
	
	Возврат ТекущиеДанные.ПолучитьИдентификатор();
		
КонецФункции

&НаКлиенте
Процедура ВыбратьИЗакрыть()
	
	Закрыть(Элементы.ДеревоНастроек.ТекущиеДанные.СписокПараметров);
	
КонецПроцедуры

#КонецОбласти




